# Compiler LLM. Used only by `vibe compile`, never by the runtime.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=vendor-model-2026-09-01
# Optional
LLM_TIMEOUT=60s
LLM_MAX_RETRIES=2
LLM_SEED=0
# Local API (Ollama), development only:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:32b-instruct-q8_0
# LLM_ALLOW_PRIVATE_HOST=true
# LLM_API_STYLE=responses  # OpenAI only: use POST /v1/responses instead of chat/completions

# Runtime database (PostgreSQL). `vibe serve` logs in directly as each
# tenant's own roles (tenant_<id>_rw / _public_reader / _public_writer,
# decision 97); the URL only names the server and database. Passwords come
# from a JSON file mapping role name -> password.
# VIBE_DATABASE_URL=postgres://localhost:5432/app
# VIBE_TENANT_DB_SECRETS=/run/secrets/vibe-tenant-db.json
# `vibe migrate` connects as the tenant's own migration role (owns only t_<id>).
# VIBE_MIGRATE_DATABASE_URL=postgres://own_tenant0001:replace-me@localhost:5432/app
# Pool and timeouts for `vibe serve` (defaults shown). Remote hosts need TLS
# unless the URL has sslmode=disable.
# VIBE_DB_POOL_SIZE=16
# VIBE_DB_POOL_TIMEOUT_MS=5000
# VIBE_DB_STATEMENT_TIMEOUT_MS=5000
# JWT: pin a public PEM (ES256 or RS256; optional VIBE_JWT_ALG) OR JWKS, not both.
# VIBE_JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# VIBE_JWT_ALG=ES256
# VIBE_JWT_ISS=https://auth.example.com/shop
# VIBE_JWT_AUD=shop
# VIBE_JWT_KID=local
# JWKS from an IdP (https only; http:// refuses to start). Default when PEM is
# unset: {VIBE_JWT_ISS}/.well-known/jwks.json
# VIBE_JWT_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# Roles claim (default roles); dotted paths like realm_access.roles are ok.
# VIBE_JWT_ROLES_CLAIM=roles
# Stored API keys (HMAC hashes), chmod 600; reloaded on mtime change.
# VIBE_API_KEYS_FILE=/etc/vibe/api-keys.json
