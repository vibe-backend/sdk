# Compiler LLM. Used only by `vibe compile`, never by the runtime.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=vendor-model-2026-09-01
# Optional
LLM_TIMEOUT=60s
LLM_MAX_RETRIES=2
LLM_SEED=0
# Local API (Ollama), development only:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:32b-instruct-q8_0
# LLM_ALLOW_PRIVATE_HOST=true

# Runtime database (PostgreSQL). `vibe serve` connects as a non-owner role
# without BYPASSRLS; it refuses to start otherwise.
# VIBE_DATABASE_URL=postgres://vibe_app:replace-me@localhost:5432/app
# `vibe migrate` connects as the owner role and grants SELECT/INSERT/UPDATE
# to VIBE_RUNTIME_DB_ROLE (required).
# VIBE_MIGRATE_DATABASE_URL=postgres://vibe_owner:replace-me@localhost:5432/app
# VIBE_RUNTIME_DB_ROLE=vibe_app
# Pool and timeouts for `vibe serve` (defaults shown). Remote hosts need TLS
# unless the URL has sslmode=disable.
# VIBE_DB_POOL_SIZE=16
# VIBE_DB_POOL_TIMEOUT_MS=5000
# VIBE_DB_STATEMENT_TIMEOUT_MS=5000
